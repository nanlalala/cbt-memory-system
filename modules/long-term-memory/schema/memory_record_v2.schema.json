{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nanlalala/cbt-memory-system/schema/memory_record_v2.schema.json",
  "title": "CBT Memory System Memory Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "user_id",
    "memory_type",
    "content",
    "origin",
    "confirmation_state",
    "lifecycle_status",
    "sensitivity",
    "confidence",
    "importance",
    "created_at",
    "observed_at",
    "updated_at",
    "source_evidence",
    "permissions",
    "source_role",
    "source_time"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_type": {
      "enum": [
        "explicit_fact",
        "preference",
        "episodic_event",
        "emotion_record",
        "goal",
        "cbt_assignment",
        "assignment_outcome",
        "cognitive_pattern",
        "user_correction",
        "safety_signal"
      ]
    },
    "content": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "explicit_user_statement",
        "user_correction",
        "agent_inference",
        "system_observation"
      ]
    },
    "confirmation_state": {
      "enum": [
        "unconfirmed",
        "user_confirmed",
        "user_corrected",
        "not_applicable"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "candidate",
        "active",
        "superseded",
        "expired",
        "deleted"
      ]
    },
    "sensitivity": {
      "enum": [
        "standard",
        "sensitive",
        "restricted"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes_memory_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_memory_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "structured_payload": {
      "type": "object"
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "turn_ids",
        "supporting_text"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "turn_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "supporting_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "memory_class": {
      "enum": [
        "fixed_historical",
        "mutable_state",
        null
      ]
    },
    "category": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "V1",
        "V2",
        "V3",
        "V4",
        "V5",
        null
      ]
    },
    "classification_status": {
      "enum": [
        "pending",
        "assigned"
      ]
    },
    "representation_kind": {
      "enum": [
        "source_quote",
        "structured_record",
        "summary",
        "index"
      ]
    },
    "source_role": {
      "enum": [
        "user",
        "assistant",
        "system",
        "unknown"
      ]
    },
    "source_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "event_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "save",
        "long_term_use",
        "response_external",
        "extraction_external"
      ],
      "properties": {
        "save": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "long_term_use": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "response_external": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "extraction_external": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "semantic_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "version"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "not_checked",
            "rule_verified",
            "validator_verified",
            "unsupported"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "claim_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "field",
          "value",
          "turn_id",
          "start",
          "end",
          "quote"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean",
              "null"
            ]
          },
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "migration_map": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_memory_id",
          "target_memory_id",
          "operation"
        ],
        "properties": {
          "source_memory_id": {
            "type": "string",
            "minLength": 1
          },
          "target_memory_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "split",
              "copy"
            ]
          }
        }
      }
    },
    "state_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "subject_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "goal_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "task_instance_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "period_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "memory_type": {
            "const": "safety_signal"
          }
        }
      },
      "then": {
        "properties": {
          "sensitivity": {
            "const": "restricted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "memory_type": {
            "const": "cognitive_pattern"
          }
        }
      },
      "then": {
        "properties": {
          "origin": {
            "const": "agent_inference"
          },
          "structured_payload": {
            "type": "object",
            "required": [
              "evidence_count"
            ],
            "properties": {
              "evidence_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "memory_type": {
            "const": "user_correction"
          }
        }
      },
      "then": {
        "required": [
          "supersedes_memory_id"
        ],
        "properties": {
          "origin": {
            "const": "user_correction"
          },
          "supersedes_memory_id": {
            "type": "string",
            "minLength": 1
          },
          "structured_payload": {
            "type": "object",
            "required": [
              "corrected_content"
            ],
            "properties": {
              "corrected_content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification_status": {
            "const": "assigned"
          }
        },
        "required": [
          "classification_status"
        ]
      },
      "then": {
        "required": [
          "memory_class",
          "category"
        ],
        "oneOf": [
          {
            "properties": {
              "memory_class": {
                "const": "fixed_historical"
              },
              "category": {
                "enum": [
                  "F1",
                  "F2",
                  "F3",
                  "F4"
                ]
              }
            }
          },
          {
            "properties": {
              "memory_class": {
                "const": "mutable_state"
              },
              "category": {
                "enum": [
                  "V1",
                  "V2",
                  "V3",
                  "V4",
                  "V5"
                ]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "classification_status": {
            "const": "pending"
          }
        },
        "required": [
          "classification_status"
        ]
      },
      "then": {
        "properties": {
          "memory_class": {
            "const": null
          },
          "category": {
            "const": null
          }
        }
      }
    }
  ],
  "$comment": "JSON clients must enforce formats, then invoke memory_contract.validate_memory_data for shared semantic/time rules. Only this checked-in vocabulary is supported by the bundled evaluator."
}
